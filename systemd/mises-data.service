[Unit]
Description=Mises Data Curator Web Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/data-curator
Environment="PATH=/opt/data-curator/.venv/bin"
Environment="FLASK_APP=src.web"
Environment="FLASK_ENV=production"
Environment="FLASK_SECRET_KEY=your-secret-key-here-change-this"
# Configura el puerto aquí (default: 5000)
Environment="FLASK_RUN_PORT=5000"
ExecStart=/opt/data-curator/.venv/bin/python -m src.web
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
