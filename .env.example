# LLM Configuration (Copilot-first)
# Primary stack: GitHub Copilot SDK
LLM_PROVIDER=copilot_sdk
COPILOT_MODEL=gpt-5-mini

# Legacy provider variables (optional, backward compatibility only)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Data Source API Keys (optional)
OECD_API_KEY=
IMF_API_KEY=


# RAG / Embeddings (OpenAI-compatible API, e.g. almacen.digital)
# OPENAI_BASE_URL=https://almacen.digital/api/v1
# OPENAI_API_KEY=your-api-key
# EMBEDDING_MODEL=text-embedding-3-small   # optional; many APIs use this
# EMBEDDING_PROVIDER=openai   # openai | local (local requires sentence-transformers)

# Project Configuration
PROJECT_NAME=Mises Data Curation
DATA_ROOT=.
